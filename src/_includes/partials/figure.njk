{# Reusable image block. Renders a real <img> when `src` is supplied and a
   marked placeholder when it is not, so a missing photograph is visible
   rather than silent. Width/height are required to prevent layout shift. #}
{% macro figure(src, alt, caption, credit, meta, ratio, wide) %}
<figure class="fig{% if wide %} fig--wide{% endif %}" data-reveal>
  {%- if src %}
  <img src="{{ src }}" alt="{{ alt }}" loading="lazy" decoding="async"
       {% if ratio %}style="aspect-ratio: {{ ratio }}"{% endif %}>
  {%- else %}
  <div class="fig__placeholder"{% if ratio %} style="aspect-ratio: {{ ratio }}"{% endif %}>
    <span class="needs-content">[NEEDS CONTENT: image &mdash; {{ alt }}]</span>
  </div>
  {%- endif %}
  {%- if caption or meta or credit %}
  <figcaption>
    {%- if caption %}<span class="fig__caption">{{ caption }}</span>{% endif %}
    {%- if meta %}<span class="fig__meta">{{ meta }}</span>{% endif %}
    {%- if credit %}<span class="fig__credit">{{ credit }}</span>{% endif %}
  </figcaption>
  {%- endif %}
</figure>
{% endmacro %}
