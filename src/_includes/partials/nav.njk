{#
  EditorialNav. Her name, the sections, and the résumé.

  Contact is a same-page anchor to the footer, which carries the site's one
  contact block and holds id="contact" on every route. It is not a mailto:
  link: a mailto opens a mail client the reader may not have configured, and
  the address is visible in the footer either way.

  The résumé link only exists when site.resume.cleared is true. While the
  current PDF is blocked it is omitted rather than rendered disabled — a
  control that does nothing is worse than one that is not there.
#}
<header class="nav">
  <p class="nav__wordmark">
    {% if page.url == "/" %}{{ site.title }}{% else %}<a href="/">{{ site.title }}</a>{% endif %}
  </p>

  <nav class="nav__sections" aria-label="Sections">
    <ul class="nav__list">
      {%- for item in site.nav %}
      <li><a href="{{ item.href }}"{% if item.href.startsWith("/#") == false and item.href != "/" and page.url.startsWith(item.href) %} aria-current="page"{% elif item.href == "/" and page.url == "/" %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
      {%- endfor %}
      <li><a href="#contact">Contact</a></li>
      {%- if site.resume.cleared %}
      <li><a class="nav__resume" href="{{ site.resume.href }}" download>Résumé <span aria-hidden="true">&darr;</span></a></li>
      {%- endif %}
    </ul>
  </nav>
</header>
