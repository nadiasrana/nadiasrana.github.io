---
layout: layouts/base.njk
---
<article class="article article--note">
  <div class="shell">
    <header class="article__head">
      <p class="labelrow">
        <span class="seed seed--{{ status }}">{{ status }}</span>
        <span class="labelrow__sep" aria-hidden="true"></span>
        <span>Planted <time datetime="{{ date | iso }}">{{ date | readable }}</time></span>
        {%- if updated %}
        <span class="labelrow__sep" aria-hidden="true"></span>
        <span>Tended <time datetime="{{ updated | iso }}">{{ updated | readable }}</time></span>
        {%- endif %}
      </p>
      <h1 class="article__title article__title--note">{{ title }}</h1>
    </header>
    <div class="prose">{{ content | safe }}</div>

    {%- if tags %}
    <ul class="tags">{% for t in tags %}<li>{{ t }}</li>{% endfor %}</ul>
    {%- endif %}

    <nav class="pager" aria-label="More notes">
      <a class="pager__item" href="/notes/">
        <span class="eyebrow">Back</span>
        <span class="pager__title">All notes</span>
      </a>
    </nav>
  </div>
</article>
