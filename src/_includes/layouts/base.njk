<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

{%- set pageDesc = description or site.tagline %}
{%- set canonical = site.url + page.url %}

{%- set byline = site.author.role + " · " + site.author.standing %}
<title>{% if title %}{{ title }} — {{ site.title }} — {{ byline }}{% else %}{{ site.title }} — {{ byline }}{% endif %}</title>
<meta name="description" content="{{ pageDesc }}">
<link rel="canonical" href="{{ canonical }}">

{%- if site.draft %}
<meta name="robots" content="noindex, nofollow">
{%- endif %}

<meta property="og:type" content="{% if layout == 'layouts/project.njk' %}article{% else %}website{% endif %}">
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:title" content="{% if title %}{{ title }} — {{ site.title }}{% else %}{{ site.title }} — {{ byline }}{% endif %}">
<meta property="og:description" content="{{ pageDesc }}">
<meta property="og:url" content="{{ canonical }}">
<meta name="twitter:card" content="summary">

<meta name="theme-color" content="#F4F1E8">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><rect width='16' height='16' fill='%23F4F1E8'/><rect x='3' y='7' width='10' height='1' fill='%231A1917'/></svg>">

{# Only the two faces that set text above the fold are preloaded. #}
<link rel="preload" href="/assets/fonts/instrument-serif-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/instrument-sans-latin-var.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/css/styles.css">

<script type="application/ld+json">
{"@context":"https://schema.org","@type":"Person",
"name":{{ site.author.name | dump | safe }},
"jobTitle":{{ site.author.role | dump | safe }},
"alumniOf":"Northeastern University",
"email":"mailto:{{ site.author.email }}",
"url":"{{ site.url }}",
"description":{{ site.tagline | dump | safe }}}
</script>
</head>

<body>

<a class="skip-link" href="#main">Skip to content</a>

<div class="canvas">
  <div class="panel">


    {% include "partials/nav.njk" %}

    <main id="main">
      {{ content | safe }}
    </main>

  </div>

  {% include "partials/footer.njk" %}
</div>

</body>
</html>
