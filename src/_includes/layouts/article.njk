---
layout: layouts/base.njk
---
{% from "partials/figure.njk" import figure %}

{# Reading progress. Scroll-driven, CSS-only, behind @supports, and removed
   entirely under prefers-reduced-motion. No JavaScript. #}
<div class="progress" aria-hidden="true"><div class="progress__bar"></div></div>

<article class="article">

  <div class="shell">
    <header class="article__head">
      <p class="labelrow">
        <span class="labelrow__cat">{{ category }}</span>
        <span class="labelrow__sep" aria-hidden="true"></span>
        <time datetime="{{ date | iso }}">{{ date | readable }}</time>
        <span class="labelrow__sep" aria-hidden="true"></span>
        <span>{{ content | readingTime }} min read</span>
        {%- if issue %}
        <span class="labelrow__sep" aria-hidden="true"></span>
        <span>Issue {{ issue }}</span>
        {%- endif %}
        {%- if status %}
        <span class="labelrow__sep" aria-hidden="true"></span>
        <span class="seed seed--{{ status }}">{{ status }}</span>
        {%- endif %}
      </p>

      <h1 class="article__title">{{ title }}</h1>
      {%- if deck %}
      <p class="article__deck">{{ deck }}</p>
      {%- endif %}
    </header>
  </div>

  {%- if coverImage or coverAlt %}
  <div class="shell">
    {{ figure(coverImage, coverAlt, coverCaption, coverCredit, coverMeta, "16/9", true) }}
  </div>
  {%- endif %}

  <div class="shell">
    <div class="article__grid">

      {# Sticky index on wide screens only. Below 60rem it collapses into a
         native <details>, which is keyboard- and screen-reader-correct with
         no ARIA and no script. #}
      <aside class="toc" aria-label="On this page">
        <details class="toc__box" open>
          <summary class="eyebrow">On this page</summary>
          <nav>{{ content | toc | safe }}</nav>
        </details>
      </aside>

      <div class="prose">
        {{ content | safe }}

        {%- if colophon %}
        <aside class="colophon-note">
          <p class="eyebrow">Colophon</p>
          <p>{{ colophon }}</p>
        </aside>
        {%- endif %}
      </div>
    </div>
  </div>

  <div class="shell">
    <div class="article__foot">
      <p class="eyebrow">Share</p>
      <ul class="sharelist">
        <li><a href="mailto:?subject={{ title | urlencode }}&amp;body={{ site.url }}{{ page.url | urlencode }}">Email this</a></li>
        <li><button class="copylink" type="button" hidden data-copy="{{ site.url }}{{ page.url }}">Copy link</button></li>
      </ul>
    </div>

    <nav class="pager" aria-label="More writing">
      {%- set prev = collections.writing | getPreviousCollectionItem %}
      {%- set next = collections.writing | getNextCollectionItem %}
      {%- if next %}
      <a class="pager__item" href="{{ next.url }}">
        <span class="eyebrow">Next</span>
        <span class="pager__title">{{ next.data.title }}</span>
      </a>
      {%- endif %}
      {%- if prev %}
      <a class="pager__item pager__item--prev" href="{{ prev.url }}">
        <span class="eyebrow">Previous</span>
        <span class="pager__title">{{ prev.data.title }}</span>
      </a>
      {%- endif %}
    </nav>

    {%- set related = [] %}
    {%- for item in collections.writing | where("category", category) %}
    {%- if item.url != page.url %}{% set related = (related.push(item), related) %}{% endif %}
    {%- endfor %}
    {%- if related.length %}
    <section class="related" aria-labelledby="related-h">
      <h2 class="eyebrow" id="related-h">More in {{ category }}</h2>
      <ol class="index">
        {%- for item in related | limit(4) %}
        <li class="index__row">
          <span class="index__num">{{ loop.index | pad }}</span>
          <span class="index__main"><a class="index__link" href="{{ item.url }}">{{ item.data.title }}</a></span>
          <time class="index__meta" datetime="{{ item.data.date | iso }}">{{ item.data.date | year }}</time>
        </li>
        {%- endfor %}
      </ol>
    </section>
    {%- endif %}
  </div>
</article>
