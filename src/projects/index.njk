{% from "macros/components.njk" import EditorialIndex, QuietEmptyState %}

<section class="section" aria-labelledby="all-h">
  <h2 class="visually-hidden" id="all-h">All projects</h2>

  {%- set items = [] %}
  {%- for p in collections.projects %}
